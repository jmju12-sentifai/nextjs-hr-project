NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 결제 승인·빌링키 발급에 필요. 서버 전용 — 절대 NEXT_PUBLIC_ 로 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
# /admin 접근을 허용할 관리자 이메일(쉼표 구분). 이 이메일로 회원가입 후 등록.
ADMIN_EMAILS=

# ── 토스페이먼츠 (빌링/정기결제) ──────────────────────────────
# 심사용 테스트 키는 토스 문서에 공개된 값을 그대로 쓸 수 있다.
#   client: test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
#   secret: test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6
# 계약 완료 후 라이브 키로 교체한다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 정기결제 갱신 크론(/api/billing/renew)을 호출할 때 쓰는 공유 비밀.
# Vercel Cron 은 이 값을 Authorization: Bearer <값> 으로 보낸다.
CRON_SECRET=
